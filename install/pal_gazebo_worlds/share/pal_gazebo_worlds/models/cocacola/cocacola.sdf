<sdf version="1.4">
  <model name="cocacola">
  <allow_auto_disable>false</allow_auto_disable>
    <static>0</static>
    <link name="link_cocacola">
      
     <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000198</ixx>
          <ixy>0.000000</ixy>
          <ixz>0.000000</ixz>
          <iyy>0.000198</iyy>
          <iyz>0.000000</iyz>
          <izz>0.000020</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.075 3.1416 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>       <!-- FONDAMENTALE: Frizione statica -->
              <mu2>100.0</mu2>     <!-- FONDAMENTALE: Frizione dinamica -->
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000.0</kp>
              <kd>100.0</kd>
              <max_vel>0.00</max_vel>
              <min_depth>0.003</min_depth> <!-- Permette alle dita di compenetrare la lattina di 1 mm per generare presa -->
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0.075 3.1416 0 0</pose>
        <geometry>
          <cylinder>
            <!--<radius>0.04</radius> -->
            <radius>0.02</radius> 
            <length>0.15</length>
          </cylinder>
        </geometry>
        <material>
          <script>
	      <uri>model://cocacola/material/scripts</uri>
	      <uri>model://cocacola/material/textures</uri>
              <name>Custom/cocacola</name>
          </script>
        </material>
      </visual>
      <velocity_decay>
        <linear>0.000000</linear>
        <angular>0.000000</angular>
      </velocity_decay>
      <self_collide>0</self_collide>
      <kinematic>0</kinematic>
      <gravity>1</gravity>
    </link>
  </model>
</sdf>
